# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채운다. (.env 는 저장소에 올라가지 않는다)
# AI 질문용 (없으면 웹의 '회사 직접 찾기'만 쓸 수 있다). 무료 키: https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에_키
# 웹 화면 비밀번호 (비워 두면 비밀번호 없이 열린다)
APP_PASSWORD=
# 분석을 처음부터 다시 돌릴 때만 필요 (웹 실행에는 필요 없음). https://opendart.fss.or.kr
DART_API_KEY=
# 👍👎 피드백을 구글 시트에 모으려면 (tools/feedback_sheet.gs 안내 참고). 비워 두면 이 PC의 data/feedback/에만 저장
FEEDBACK_URL=
FEEDBACK_TOKEN=
